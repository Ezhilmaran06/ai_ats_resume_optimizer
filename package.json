{
  "name": "ai-ats-resume-optimizer",
  "version": "1.0.0",
  "description": "AI ATS Resume Optimizer — AI-Powered Resume Scoring & Optimization Platform",
  "main": "server/server.js",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client dev",
    "client:build": "npm --prefix client build",
    "ai": "python -m uvicorn app.main:app --app-dir ai-service --port 8000 --reload",
    "ai:start": "python -m uvicorn app.main:app --app-dir ai-service --port 8000",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "start": "node server/server.js"
  },
  "keywords": ["ats", "resume", "ai", "job-matching", "react", "express", "mongodb"],
  "author": "Ezhilmaran",
  "license": "MIT"
}
