PORT=5000
NODE_ENV=development

# Database Configuration (Optional: falls back to in-memory Mongo if omitted/unreachable)
MONGODB_URI=mongodb://localhost:27017/resume_ai

# JWT Authentication
JWT_SECRET=super_secret_resume_ai_jwt_key_2025_secure!
JWT_EXPIRE=7d

# AI Service Configuration (Optional: falls back to built-in rule-based NLP engine)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
# Alternative LLM endpoints (e.g., https://generativelanguage.googleapis.com or OpenAI-compatible)
AI_API_BASE_URL=

# Email Configuration (Optional for reset emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="ResumeAI <noreply@resumeai.io>"
